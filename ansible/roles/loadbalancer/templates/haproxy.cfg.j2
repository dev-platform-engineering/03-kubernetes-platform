global
    log /dev/log local0
    log /dev/log local1 notice

    daemon

    stats socket /run/haproxy/admin.sock mode 660 level admin

    user {{ haproxy_user }}
    group {{ haproxy_group }}


defaults
    log global

    mode {{ haproxy_mode }}

    option tcplog

    timeout connect 5s
    timeout client 50s
    timeout server 50s


frontend kubernetes_api
    bind {{ haproxy_bind_address }}:{{ haproxy_bind_port }}

    mode tcp

    default_backend kubernetes_api_backend


backend kubernetes_api_backend
    mode tcp

    balance {{ haproxy_balance_method }}

{% for host in groups['control_plane'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ kubernetes_api_port }} check inter 2s fall 3 rise 2
{% endfor %}