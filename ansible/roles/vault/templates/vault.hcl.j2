ui = {{ vault_ui_enabled | lower }}

disable_mlock = false

storage "raft" {
  path    = "{{ vault_storage_path }}"
  node_id = "{{ inventory_hostname }}"

{% for host in groups['vault_cluster'] %}
  retry_join {
    leader_api_addr         = "https://{{ host }}.{{ vault_domain }}:{{ vault_api_port }}"
    leader_ca_cert_file     = "{{ vault_tls_ca_cert }}"
    leader_client_cert_file = "{{ vault_tls_server_cert }}"
    leader_client_key_file  = "{{ vault_tls_server_key }}"
  }
{% endfor %}
}

listener "tcp" {
  address         = "{{ vault_listener_address }}"
  cluster_address = "{{ vault_cluster_listener_address }}"

  tls_disable     = false
  tls_cert_file = "{{ vault_tls_server_cert }}"
  tls_key_file  = "{{ vault_tls_server_key }}"
}

api_addr     = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"