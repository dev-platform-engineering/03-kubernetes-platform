[vyos_routers]
vyos_router_01 ansible_host=10.50.10.11 ip_suffix=1 router_priority=200 bgp_as=65000 loopback_ip=10.255.255.1 
vyos_router_02 ansible_host=10.50.10.12 ip_suffix=2 router_priority=100 bgp_as=65000 loopback_ip=10.255.255.2

[repository_servers]
repo-01 ansible_host=10.50.60.60 fqdn=repo-01.infra.platform.

